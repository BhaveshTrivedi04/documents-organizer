# Optional: password the family types once on each phone. Leave empty to choose it on the site the first time.
FAMILY_PASSWORD=
# Any long random string (used to sign the login cookie)
AUTH_SECRET=replace-with-a-long-random-string
# Added automatically by Vercel when you connect a Blob store
BLOB_READ_WRITE_TOKEN=
# "basic" (Rs 2,000: up to 50 documents, 10 per person) or "premium" (Rs 3,000: unlimited). Empty means premium.
PLAN=
# Optional: UPI ID shown on the public /buy page, with a "Pay with a UPI app" button
UPI_ID=
# Optional: one /buy page for every copy (e.g. https://your-main-site.vercel.app/buy). Empty uses this copy's /buy page.
NEXT_PUBLIC_BUY_URL=
